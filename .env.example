# Copy this file to ".env" and fill it in. NEVER publish the .env file.

# HTTPS RPC that is allowed to send transactions (the public api.mainnet-beta.solana.com often cannot).
# Examples from the official pump.fun repo: https://rpc.solanatracker.io/public, https://rpc.ankr.com/solana
# Recommended for production: your own RPC endpoint (e.g. Helius, QuickNode), otherwise you hit rate limits.
SOLANA_RPC_URL=

# Contract address (mint) of your coin, known after the launch
MINT=

# Path to the key file of the CREATOR wallet (the wallet you used to create the coin on pump.fun).
# Format: JSON array (solana-keygen) OR a single base58 line (Phantom export).
# Use this wallet ONLY for the coin: fees land here, buys and burns happen here.
KEYPAIR_PATH=./creator-wallet.json
# OR (for Railway/Render, where there is no file): the key as base58 text from Phantom → Settings → Export Private Key
KEYPAIR_BASE58=

# Optional, only if you enable devBagBurn in director.config.json. Default: OFF – the team's launch buy stays with the team.
DEV_BAG_TOKENS=

# Wallet for the lab share (50 % of the fees per director.config.json). Paid out immediately at every collection.
# Leave empty = the share stays in the creator wallet (the bot never touches it, but the website shows it).
TREASURY_WALLET=

# Optional: link to the public code (shown on the website under "Proof")
REPO_URL=

# Optional: Claude API key for the log lines (without a key: templates)
ANTHROPIC_API_KEY=

# Optional: Discord webhook (or compatible) – every burn is posted there
WEBHOOK_URL=

# How often the bot checks (minutes). Feeding still only happens according to the rules.
POLL_MINUTES=1

# Port of the built-in website (Railway/Render set PORT automatically). SERVE=0 disables the website.
PORT=3000
