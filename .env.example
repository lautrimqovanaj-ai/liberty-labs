# Kopiere diese Datei zu ".env" und fülle sie aus. Die .env NIE veröffentlichen.

# HTTPS-RPC, der Transaktionen senden darf (der öffentliche api.mainnet-beta.solana.com kann das oft nicht).
# Beispiele laut offiziellem pump.fun-Repo: https://rpc.solanatracker.io/public, https://rpc.ankr.com/solana
# Empfehlung für den Betrieb: ein eigener RPC-Zugang (z. B. Helius, QuickNode), sonst Rate-Limits.
SOLANA_RPC_URL=

# Contract-Adresse (Mint) deines Coins nach dem Launch
MINT=

# Pfad zur Schlüsseldatei des CREATOR-Wallets (das Wallet, mit dem du den Coin auf pump.fun erstellt hast).
# Format: JSON-Array (solana-keygen) ODER eine Zeile base58 (Phantom-Export).
# Dieses Wallet soll NUR für den Coin benutzt werden – dort landen die Fees, dort wird gekauft und verbrannt.
KEYPAIR_PATH=./creator-wallet.json
# ODER (für Railway/Render, wo es keine Datei gibt): der Schlüssel als base58-Text aus Phantom → Einstellungen → Private Key exportieren
KEYPAIR_BASE58=

# Optional, nur falls du devBagBurn in director.config.json einschaltest. Standard: AUS – dein Dev-Kauf bleibt bei dir.
DEV_BAG_TOKENS=

# Wallet für deinen Anteil (50 % der Fees laut director.config.json). Wird bei jedem Einsammeln sofort überwiesen.
# Leer lassen = der Anteil bleibt im Creator-Wallet liegen (Bot rührt ihn nicht an, zeigt ihn aber auf der Website).
TREASURY_WALLET=

# Optional: Link zum öffentlichen Code (wird auf der Website unter «Proof» gezeigt)
REPO_URL=

# Optional: Claude-API-Schlüssel für die Kommentare im Log (ohne Schlüssel: Vorlagen)
ANTHROPIC_API_KEY=

# Optional: Discord-Webhook (oder kompatibel) – jeder Burn wird dort gepostet
WEBHOOK_URL=

# Wie oft der Bot nachschaut (Minuten). Gefüttert wird trotzdem nur nach den Regeln.
POLL_MINUTES=1

# Port der eingebauten Website (Railway/Render setzen PORT automatisch). SERVE=0 schaltet die Website aus.
PORT=3000
